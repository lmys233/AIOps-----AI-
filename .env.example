# ============================================================
#  环境变量样例（task.md T1）
#
#  ★ 用法：复制为 .env 并按需修改。
#    .env 已在 .gitignore 中，不会入库。
#
#  ★ 两类配置项的语义严格区分：
#      · 「必需」—— 无默认值，缺失会导致**启动即失败**（fail-fast）
#      · 「有默认」—— 缺失时使用 spec 规定的默认值
#
#  ★ 建议解释器：Python 3.12 + pydantic v2
#
#  ★ 本文件**只管 AIOps Agent 自己的配置**（AIOPS_*）。
#    被观测业务系统的环境变量由启动器逐个构造，不在此处（见文末说明）。
# ============================================================

# ------------------------------------------------------------
#  【平台权威存储；注册系统/持久任务需要】数据源（spec §8.1 数据源总览）
#
#  ★ 一律用 127.0.0.1，**不要写 localhost**（BUG-033）：
#    本机 localhost 解析 `::1` 在前，而 Docker 发布的端口只绑 IPv4 ——
#    用 localhost 会先被拒一次，偶发的"连接被拒绝"就是这么来的。
# ------------------------------------------------------------
AIOPS_DATABASE_URL=postgresql://aiops:aiops_dev_pw@127.0.0.1:5432/aiops
AIOPS_REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------
#  【按接入能力配置；缺来源应明确降级】遥测数据源（spec §8.1）
# ------------------------------------------------------------
AIOPS_PROMETHEUS_URL=http://127.0.0.1:9090
AIOPS_LOKI_URL=http://127.0.0.1:3100
AIOPS_TEMPO_URL=http://127.0.0.1:3200
AIOPS_OTLP_ENDPOINT=http://127.0.0.1:4317

# ------------------------------------------------------------
#  【可选增强；未配置不能冒称完整识别/回答】LLM 网关（spec §7.6）
#  ★ spec §1.3：不得硬编码模型名；主力模型可替换（API ↔ 本地）
#
#  ★ 两家都是 **OpenAI 兼容**协议，换供应商只改这两行（代码一行不动）：
#
#     base_url、model与key由部署提供；具体可用模型以供应商当前接口为准。
#  默认三级意图是规则 -> few-shot向量 -> 主力模型，不是小模型快路由。
#  同网关/同模型的质量评审不是独立外部事实证明，供应商推理/usage能力需实测。
#  AIOPS_ROUTER_MODEL仅保留旧显式注入路由兼容；默认插件使用主力模型兜底。
#  ★ base_url 带不带 `/v1` 都能用（客户端会归一化；两家官方文档写法不一致）
#  ★ 填好后用这条命令验证（**唯一需要外网**的一条）：
#       .\run.ps1 llm-check
#    先 `GET /models` 探活（不耗 token），再做一次极小的结构化输出，
#    打印 token 记账与耗时。**不会打印你的 key**（只报长度）。
#
#  ★ 供应商能力差异由网关自动适配（本任务实测）：
#    · 支持 function calling 的模型 → 走**约束解码**（更强）
#    · 不支持（如思考型 v4-pro，会返回 400）→ 自动退回 **JSON mode**
#    两条路径的最终判据都是 **Pydantic schema 校验**（协议层说"我保证"不算数）。
# ------------------------------------------------------------
AIOPS_LLM_BASE_URL=https://api.deepseek.com
AIOPS_LLM_MODEL=deepseek-flash

# A finite logical deadline includes assembly, fallback and backoff. QA generation
# and routing remain <=25s; whole review <=45s. Physical attempts share one cap.
AIOPS_MODEL_CALL_TIMEOUT_SEC=60
AIOPS_MODEL_MAX_ATTEMPTS=4
AIOPS_MODEL_RETRY_BACKOFF_SEC=0.2
AIOPS_MODEL_MAX_BACKOFF_SEC=2
AIOPS_QA_REVIEW_TIMEOUT_SEC=45
# See docs/knowledge-stability.md; task limits/permissions/quality gates remain.
# 应用的单次上下文窗口（提示/schema/输出预留）；不是累计任务token预算。
# 本地估算不是供应商分词器，按实际接入模型调整，默认32768。
AIOPS_LLM_CONTEXT_TOKENS=32768
# 旧路由兼容参数；不改变默认规则/向量/主力模型插件链路。
AIOPS_ROUTER_MODEL=deepseek-flash
# ------------------------------------------------------------
#  API Key：★ 本文件是**入库的模板**，这里只留空！
#
#    真 key 请写进仓库根的 `.env`（已在 .gitignore 第 23 行忽略）：
#        Copy-Item .env.example .env
#        notepad .env          # 填 AIOPS_LLM_API_KEY=...
#
#    ⚠️ 写进本文件（.env.example）会让 key 随 git 历史泄露 —— 那是**不可回滚**的。
# ------------------------------------------------------------
AIOPS_LLM_API_KEY=

# ------------------------------------------------------------
#  【有默认】工具层 · 高危管控（T16b）
#
#  ★ 写能力开关：**默认关闭**。未开启时：
#      · 内置 change_write 仍在册（spec §8.7 的 9 工具契约），但**调用会被拒**；
#      · 扩展工具若声明写能力，**注册即被拒**（危险工具不进注册表）。
#    取值只认 1/true/yes/on（写 "false" 也是关闭 —— 不会因为"非空串"被当成打开）。
# ------------------------------------------------------------
AIOPS_ALLOW_WRITE_TOOLS=false

# ------------------------------------------------------------
#  【有默认】工具层 · 扩展清单（T16b）
#
#  ★ 只有清单里**显式列出**且 enabled: true 的模块才会被加载（不做目录扫描 ——
#    那等于"谁能写文件谁就能给自己加工具"）。留空 = 用默认的
#    `src/agent/tools/extensions.yaml`。
# ------------------------------------------------------------
# AIOPS_TOOL_MANIFEST=deploy/tools/extensions.yaml

# ------------------------------------------------------------
#  【有默认】编排预算（spec §3.5 终止条件）
#  ★ max_rounds 上限强制为 5（spec §6.1），超过直接报错
# ------------------------------------------------------------
AIOPS_MAX_ROUNDS=3
AIOPS_MAX_LLM_CALLS=40
AIOPS_MAX_TOOL_CALLS=80
AIOPS_MAX_TOKENS=200000
AIOPS_MAX_WALL_TIME_SEC=300

# ------------------------------------------------------------
#  【有默认】日志与运行环境
#  ★ 注意：不提供 AIOPS_SERVICE_NAME ——
#    服务名必须作为**函数参数**显式传入（同一份代码跑 4 个服务，
#    读环境变量会串味）。见 src/agent/common/config.py。
# ------------------------------------------------------------
AIOPS_LOG_LEVEL=INFO
AIOPS_ENV=prod

# ------------------------------------------------------------
#  【说明】部署身份（集群名/环境/命名空间）——**不要在 .env 里写**
#
#  ★ 它的唯一定义处是 `deploy/.env` 的 `OBSERVED_CLUSTER` / `OBSERVED_ENV` /
#    `OBSERVED_NAMESPACE`：观测栈（prometheus/promtail/tempo/otel-collector）
#    与 SDK 自报（`GET /health`、`GET /services`）读的必须是同一个值。
#
#  ★ `run.ps1` 启动时会把它读进环境（`OBSERVED_*` → `AIOPS_CLUSTER` /
#    `AIOPS_ENV` / `AIOPS_NAMESPACE`），业务进程与 Agent 都从这里取。
#    临时试另一个集群名时，直接设环境变量即可（环境变量优先于 deploy/.env）：
#        $env:AIOPS_CLUSTER = "another"; .\run.ps1 business-up
#
#  ★ 留空 = "没配置"：SDK 与 Agent 都如实报"未知"，**不得自造默认值**
#    （造出来的值会让「集群未知」与「真的是这个集群」再也分不开，spec §7.1）。
# ------------------------------------------------------------

# ------------------------------------------------------------
#  【已删除】被观测系统的故障注入旋钮（原 spec §8.8）
#
#  ★ 这 5 个旋钮已随 T6 重规划**从业务系统里彻底删除**：
#
#      order   · DB_POOL_SIZE / DB_POOL_ACQUIRE_HOLD_MS / DB_POOL_TIMEOUT_SEC
#      payment · ARTIFICIAL_DELAY_MS / ARTIFICIAL_ERROR_RATE
#
#    业务系统只保留**正常配置项**（`DB_POOL_SIZE` / `DB_POOL_TIMEOUT_SEC`
#    是连接池的正常运维参数，由启动器喂给带池的服务），
#    **不再从环境读任何"旋钮"**，因此业务代码里也没有 `fault_injection_active`
#    的置位逻辑（指标仍按 §8.5 暴露，正常态恒为 0）。
#
#  ★ 故障场景改由**外部手段**制造：停 Postgres、限制资源、
#    注入网络延迟、对进程 `docker pause` 等 —— 更接近真实生产，
#    也不需要在业务代码里留后门。
#    （偏差已记入 `task.md` T6「偏差与影响」与 `决策记录.md` F1）
#
#  ★ 于是本节原来的那个陷阱也一并消失：
#    旧版把旋钮写在**根目录 .env**（compose 的 `env_file:`）会被
#    `environment: "${DB_POOL_SIZE:-20}"` 的插值悄悄盖掉，旋钮静默失效。
#    现在被观测系统已不在容器里，这个插值链路整条不存在了。

# ------------------------------------------------------------
#  【说明】被观测业务系统（4 个服务）的运行期变量 —— 不由本文件管理
#
#  ★ 它们由启动器 `src/observed/native_run.py` 在拉起每个服务时
#    **逐个构造并互相隔离**（见其 `service_env()`）。
#    业务服务在宿主上以原生进程运行，**不在容器里**。
#
#  ★ 一条命令起全部（前台运行，Ctrl+C 停止）：
#      .\run.ps1 business-up
#
#  启动器注入的键（参考值）：
#      SERVICE_NAME        = gateway|order|payment|inventory
#      RUNNER_DATABASE_URL = postgresql://aiops_runner:runner_dev_pw@127.0.0.1:5432/aiops
#      ORDER_URL / INVENTORY_URL / PAYMENT_URL = http://127.0.0.1:<8080~8083>
#      LOG_LEVEL           = INFO
#      DB_POOL_SIZE        = 20   （仅带连接池的服务：order/inventory/payment）
#      DB_POOL_TIMEOUT_SEC = 3    （仅带连接池的服务）
#
#  ★ 需要临时覆盖时，在 shell 里设好再起 —— 启动器会读到：
#      $env:DB_POOL_SIZE = "5"; .\run.ps1 business-up
#    ⚠️ 注意：`DB_POOL_SIZE` 是**正常配置项**，不再有 `fault_injection_active`
#       帮你确认"它是否真的生效"。要确认就查 order 的 `/pool-stats`
#       （`pool_size_configured` 字段）。
# ------------------------------------------------------------

# ============================================================
#  ★ 审核 3 新增：服务壳的安全姿态与告警吞吐（都可留空 = 用默认值）
# ============================================================

# 共享密钥。**配了就所有 /v1/* 必须带对**（`Authorization: Bearer <token>`
# 或 `X-AIOps-Token`）。空 = 无鉴权（此时只有"显式声明"才放行，见下）。
# ★ 非回环绑定又没有它 → `python -m agent` 直接拒绝启动（退出码 2）。
AIOPS_AGENT_TOKEN=

# 显式声明"这次不要鉴权"（本机开发用）。**不设这个变量又不配密钥 = 所有 /v1/* 一律 403**
# —— 这是 fail-closed：保护跟着能力走，绕过 CLI 用 `uvicorn --factory agent.api.app:create_app`
# 也挡得住。`python -m agent` 在**回环绑定**时会自动替你声明。
# 取值：1/true/yes/on/是
AIOPS_ALLOW_UNAUTHENTICATED=

# 告警接入的**全局吞吐配额**：一个抑制窗口（默认 5min）内允许真正入队的告警总数。
# 默认 60。每请求 20 条那个上限挡不住"重复发不同指纹的批次"，这一条才是账单硬上界。
AIOPS_ALERT_MAX_PER_WINDOW=

# ============================================================
#  P2/T30 · 共享状态（会话闸门 / 告警幂等与抑制 / 配额 / 结果留存 / 待确认动作）
# ============================================================
# 不配置 = **进程内实现**（单进程语义：重启会丢幂等/抑制，多实例各记一份）。
# 配置且探测通过 = Redis 实现（多实例 + 重启不丢）；探测失败 → **自动退回进程内**，
# 并把原因写进日志与响应 `degraded`（"记不住"这件事不许静默）。
# ★ 键空间见 spec v0.2 §8.6（键名带 `tenant` 前缀，且**全部带 TTL**）。
# ★ 演示/自测建议单独用一个 DB（例如 /5），别和工作记忆（/0）混在一起。
AIOPS_STATE_REDIS_URL=

# ============================================================
#  P2/T52g · 被观测系统的**部署形态事实**（决定用户可见文案里的机制名词）
# ============================================================
# 取值：host_process（宿主原生进程）| k8s（K8s 工作负载）| 留空 = unknown。
# ★ 为什么要有这一项：处置方案里会出现"实例 / Pod / 副本"这类机制名词，它们
#   **必须来自事实** —— 配了 k8s 才谈 Pod；事实是宿主进程就说"实例"；
#   没配就只说"实例"并**明说**"部署形态未配置"，**绝不猜**。
#   靠"禁词表"过滤只是把同一个错误换个词再犯一次（用户 2026-10-03 裁决）。
# ★ 本项目实测事实 = host_process（4 个业务服务由 src/observed/native_run.py
#   在宿主上以原生进程拉起，见根目录 .env 文末说明）。
AIOPS_DEPLOYMENT_FORM=host_process

# 动态归因：关闭后回退旧八类评分链路；工具扩展仅在开启时注册
AIOPS_ATTRIBUTION_V2=true
# 管理员提供的服务数据库只读检查映射（见 docs/attribution-v2.md）；未填会明确缺口
AIOPS_DB_INSPECTION_MAP=
# 完整聊天档案（默认复用平台 AIOPS_DATABASE_URL；可独立指定，不使用业务检查连接）
# AIOPS_HISTORY_DATABASE_URL=postgresql://<platform-user>:<password>@<host>:<port>/<platform-db>
# 已注册系统始终通过任务控制/执行台账；off 不再绕到旧未登记执行。
AIOPS_TASK_CONTROL=on
# 固定查询计划默认 on；off 仅关闭新绑定，旧工具直调仍核验注册并编译隔离范围。
AIOPS_QUERY_SPEC=on
# Saved AnswerView projection; off affects new turns only, not saved archives or isolation.
AIOPS_ANSWER_VIEW=on
# 映射里的 dsn_env 引用此类变量；不自动复用 AIOPS_DATABASE_URL 或记忆 Redis
# BUSINESS_INSPECTION_DSN=postgresql://<read-only-user>:<password>@<host>:<port>/<business-db>

# 应用/数据库诊断；先配置真实采集来源，未配置不当作正常
AIOPS_APPLICATION_DIAGNOSTICS=false
AIOPS_DIAGNOSTIC_SOURCES=
# AIOPS_DIAGNOSTIC_DATABASE_URL= 平台诊断档案连接，未指定复用 AIOPS_DATABASE_URL
AIOPS_DIAGNOSTIC_HTTP_SLOW_MS=1000
AIOPS_DIAGNOSTIC_SQL_SLOW_MS=500
AIOPS_DIAGNOSTIC_ABSOLUTE_THRESHOLDS={}
# SDK/外部观察器：凭据只在环境中，服务/环境/来源必须匹配来源绑定
AIOPS_SDK_DIAGNOSTICS=on
AIOPS_SDK_DIAGNOSTICS_URL=
AIOPS_SDK_DIAGNOSTICS_TOKEN=
# V2-T27：可选部署 profile 的 env_refs 引用；实际名称由部署清单决定。
# 不把平台 LLM/档案连接凭据整批传给被观测进程。
# CATALOG_DIAGNOSTIC_TOKEN=
# CATALOG_DATABASE_URL=
AIOPS_SDK_DEPLOYMENT_PROFILE=
AIOPS_SDK_SUCCESS_SAMPLE_EVERY=10
AIOPS_SDK_DB_IDENTITY_READ=off
AIOPS_SDK_SNAPSHOT_INTERVAL=0
# 可选旁路观察已核实 Uvicorn 停机取消分支，默认关闭，不匹配报告 unsupported。
AIOPS_SDK_UVICORN_SHUTDOWN_OBSERVE=off
AIOPS_DIAGNOSTIC_ROLES=database_agent,runtime_agent,lifecycle_agent
# Task dialogue reuses archived diagnosis; off returns to the previous routing flow.
AIOPS_TASK_DIALOGUE=on
# Cumulative task ceilings; values can tighten but cannot exceed these defaults.
AIOPS_TASK_MAX_TOKENS=200000
AIOPS_TASK_MAX_TOOLS=80
AIOPS_TASK_MAX_MODEL_CALLS=40
AIOPS_TASK_MAX_WALL_MS=300000

# Multiple independent systems: enable after issuing enrollments and registering SDKs.
# The current formal deployment is on; off is only for isolated legacy compatibility tests.
AIOPS_MULTI_SYSTEM=on
# Persistent platform signing key, shared by replicas. Back up the key with the registry.
# AIOPS_OBSERVED_SIGNING_KEY_FILE=/run/secrets/observed-registry.key
# For a Docker Prometheus polling host-native SDK metrics targets:
# AIOPS_PROMETHEUS_HOST_GATEWAY=host.docker.internal
# SDK deployment only; use observed-name in application config or AIOPS_OBSERVED_NAME.
# ACCOUNTING_REGISTRATION_TOKEN= administrator-issued enrollment, never put into prompts
# AIOPS_SDK_REGISTRATION_TOKEN= supplied through a deployment env reference
# AIOPS_SDK_REGISTRATION_URL=http://aiops.internal:8020/v1/observed/register
# AIOPS_SDK_ADVERTISE_URL=http://accounting-api.internal:8081

# Intent plugin: rules -> BGE few-shot vectors -> main model (AIOps deployment only).
AIOPS_INTENT_EMBEDDING_PROVIDER=bge
AIOPS_INTENT_BGE_MODEL=BAAI/bge-small-zh-v1.5
# Model is loaded from an already deployed local cache/directory, no request-time download.
# AIOPS_INTENT_BGE_PYTHON=/opt/aiops-embeddings/bin/python
# AIOPS_INTENT_EMBEDDING_REVISION=pin-or-local-model-version
AIOPS_INTENT_VECTOR_THRESHOLD=0.84
AIOPS_INTENT_VECTOR_MARGIN=0.12
# Optional provider=http (base URL includes /v1 when needed), or explicit lexical.
# AIOPS_INTENT_EMBEDDING_URL=http://embeddings.internal:8000/v1
# AIOPS_INTENT_EMBEDDING_MODEL=your-embedding-model
# AIOPS_INTENT_EMBEDDING_KEY=deployment-secret-reference

# Knowledge QA: shares the configured BGE/HTTP provider above; never installed into SDK.
# PostgreSQL must have pgvector (already supplied by deploy/docker-compose.yml).
AIOPS_KB_CHUNKER=hierarchical
AIOPS_KB_CHUNK_SIZE=360
AIOPS_KB_CHUNK_OVERLAP=80
AIOPS_KB_PARENT_SIZE=2400
# Semantic candidate threshold; RRF scores are ranks, not confidence probabilities.
AIOPS_KB_VECTOR_THRESHOLD=0.65
# Only command planning: provider reasoning extensions. {} disables automatic
# DeepSeek protocol optimization for this role.
# AIOPS_COMMAND_MODEL_OPTIONS={"thinking":{"type":"disabled"}}
# Candidate proposals use a separate bounded JSON generation stage; this never
# grants confirmation authority. {} keeps the provider's own default reasoning.
# AIOPS_ATTRIBUTION_MODEL_OPTIONS={"thinking":{"type":"disabled"}}
# Structured QA/metric roles: official DeepSeek defaults to thinking disabled;
# other providers retain defaults. Explicit {} preserves provider behavior.
# Only reasoning knobs are accepted; evidence validation is unchanged.
# AIOPS_QA_MODEL_OPTIONS={"thinking":{"type":"disabled"}}
# AIOPS_QA_REVIEW_MODEL_OPTIONS={"thinking":{"type":"disabled"}}
# AIOPS_METRIC_MODEL_OPTIONS={"thinking":{"type":"disabled"}}
# AIOPS_TASK_DIALOGUE_MODEL_OPTIONS={"thinking":{"type":"disabled"}}
# 结构化协议：auto / function / json。auto对官方DeepSeek预选JSON，避免思考模式拒绝强制函数调用。
# AIOPS_LLM_STRUCTURED_MODE=auto

# 答案反馈与偏好（先记录，再影子学习；通过评测后再开启应用）
AIOPS_FEEDBACK_ENABLED=1
AIOPS_PREFERENCE_LEARNING_ENABLED=0
AIOPS_PREFERENCE_APPLY_ENABLED=0
AIOPS_PREFERENCE_CONTEXT_TOKENS=50000
AIOPS_PREFERENCE_TRIGGER_TOKENS=50000
AIOPS_PREFERENCE_BACKLOG_TOKENS=100000
# 三项后台每日预算都大于0才可调用模型；按tenant/subject分别累计，未知费用保留预留。
AIOPS_PREFERENCE_DAILY_MODEL_CALLS=30
AIOPS_PREFERENCE_DAILY_TOKENS=100000
AIOPS_PREFERENCE_DAILY_WALL_SEC=240
# 默认沿用现有模型窗口；如确知该模型支持更大窗口才显式配置，仍钳制到50k。
# AIOPS_PREFERENCE_MODEL_CONTEXT_TOKENS=50000
# AIOPS_PREFERENCE_API_SUBJECTS={"授权token的SHA256":"可信API主体"}
