# ==================================================================
#  部署身份样例 —— 复制为 `deploy/.env` 后按你的部署改（审核 LOW：补模板）
#
#  ★ 为什么需要这个文件：`deploy/.env` 是**集群名/环境的唯一定义处**
#    （spec §8.4 约定 4），而它已被 `.gitignore` 排除 —— 新克隆的仓库里
#    没有它，所有身份字段会**静默报 null**，"只改一处"这条性质也就无法复现
#    （四份采集端配置引用 `${OBSERVED_CLUSTER}`，展开成空串不会报错）。
#
#  用法：
#    Copy-Item deploy\.env.example deploy\.env      # Windows PowerShell
#    cp deploy/.env.example deploy/.env             # Linux/macOS
#    然后只改下面三行。
#
#  谁读它：
#    · `docker compose`（compose 文件与本文件同目录，变量替换自动生效）
#      → 传给 prometheus / promtail / tempo / otel-collector 容器；
#    · `run.ps1`（启动被观测业务与 Agent 前读进环境，导出 `AIOPS_CLUSTER` 等）
#      → SDK 自报（`GET /health`、`GET /services`）、Agent 侧实体对齐。
#
#  ★ 留空 = "没配置"：两侧都会如实报"未知"，**不得自造默认值**
#    （造出来的值会让「集群未知」与「真的是这个集群」再也分不开，spec §7.1）。
#    ★ 也**不要**写 unknown / none / default 这类占位值 —— 它们会被契约层拒掉
#      （`common/contracts.PLACEHOLDER_CLUSTERS`）。
#
#  ★ 本文件**不是密钥文件**（没有凭据），可以进版本库；
#    真正的凭据仍在项目根的 `.env`（gitignore）。
# ==================================================================

# 集群名（Kubernetes 生态里对应 OTel 语义约定的 k8s.cluster.name）
OBSERVED_CLUSTER=

# 环境（三选一：prod / staging / dev）
OBSERVED_ENV=

# 命名空间（单命名空间部署可留空；K8s 里对应 k8s.namespace.name）
OBSERVED_NAMESPACE=
